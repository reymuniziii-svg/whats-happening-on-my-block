SOCRATA_APP_TOKEN=
NEXT_PUBLIC_APP_URL=http://127.0.0.1:3000

# Optional: preferred geocoder
GEOCLIENT_APP_ID=
GEOCLIENT_APP_KEY=

# Optional: Redis cache/rate-limit backend
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Optional: Postgres for persistent watchlists/digest runs
DATABASE_URL=

# Optional: MTA feed auth/override
MTA_API_KEY=
MTA_SERVICE_ALERTS_URL=

# Required for server-signed watchlist cookies in production
WATCHLIST_SIGNING_SECRET=

# Required for internal cron digest endpoint
CRON_SECRET=

# Optional: Google Sheets digest export
GOOGLE_SHEETS_SPREADSHEET_ID=
GOOGLE_SHEETS_WORKSHEET_NAME=WeeklyDigest
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY=
